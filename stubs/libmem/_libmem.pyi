"""Type stub for the libmem._libmem C extension (libmem 5.1.4).

Hand-written and verified against the compiled module: the exported names,
class attributes, and constants below were introspected directly from
_libmem.cpython-*.so (see strings.txt for the raw symbol dump). The public
Python wrapper in libmem/__init__.py re-exports these under friendlier names.
"""

# ── opaque value types ────────────────────────────────────────────────────────

class lm_arch_t:
    """Stores a processor architecture."""

class lm_prot_t:
    """Stores memory protection flags."""

# ── record types ──────────────────────────────────────────────────────────────

class lm_process_t:
    """Stores information about a process."""
    pid: int
    ppid: int
    arch: lm_arch_t
    bits: int
    start_time: int
    path: str
    name: str

class lm_thread_t:
    """Stores information about a thread."""
    tid: int
    owner_pid: int

class lm_module_t:
    """Stores information about a module."""
    base: int
    end: int
    size: int
    path: str
    name: str

class lm_symbol_t:
    """Stores information about a symbol."""
    name: str
    address: int

class lm_segment_t:
    """Stores information about a segment."""
    base: int
    end: int
    size: int
    prot: lm_prot_t

class lm_inst_t:
    """Stores information about an instruction."""
    mnemonic: str
    op_str: str
    bytes: bytearray
    address: int
    size: int

class lm_vmt_t:
    """Manages a Virtual Method Table."""
    def __init__(self, vtable_address: int) -> None: ...
    def hook(self, fn_index: int, dst: int) -> None:
        """Hooks a VMT function at an index"""
    def unhook(self, fn_index: int) -> None:
        """Unhooks a VMT function at an index"""
    def get_original(self, fn_index: int) -> int:
        """Gets the original VMT function at an index"""
    def reset(self) -> None:
        """Resets the original VMT"""

